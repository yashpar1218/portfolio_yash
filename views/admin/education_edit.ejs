<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Edit Education</h1>
        <p class="text-muted small mb-0">Update academic qualification details</p>
      </div>
      <a href="/admin/education_list" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i> Back to Education
      </a>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <form action="/admin/update_education/<%= education.edu_id %>" method="post">
              <div class="mb-3">
                <label class="form-label fw-semibold">Duration / Years</label>
                <input type="text" name="edu_dur" class="form-control" value="<%= education.edu_dur %>" placeholder="e.g. 2024 - 2026" required />
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Degree / Certification</label>
                <input type="text" name="edu_deg" class="form-control" value="<%= education.edu_deg %>" required />
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Institution / College</label>
                <input type="text" name="edu_coll" class="form-control" value="<%= education.edu_coll %>" required />
              </div>

              <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/admin/education_list" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save me-1"></i> Update Education
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>
