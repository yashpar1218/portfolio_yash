<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Manage Services</h1>
        <p class="text-muted small mb-0">Overview of your professional service offerings</p>
      </div>
      <a href="/admin/service_add" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Add Service
      </a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Icon</th>
                <th>Service Name</th>
                <th>Description</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (service && service.length > 0) { %>
                <% for (let i = 0; i < service.length; i++) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td>
                      <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="<%= service[i].ser_ico %>"></i>
                      </div>
                    </td>
                    <td class="fw-semibold"><%= service[i].ser_nam %></td>
                    <td class="text-truncate" style="max-width: 300px;"><%= service[i].ser_des %></td>
                    <td class="text-end">
                      <a href="/admin/edit_service/<%= service[i].ser_id %>" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                      </a>
                      <a href="/admin/delete_service/<%= service[i].ser_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this service?')" title="Delete">
                        <i class="fas fa-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% } %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">No services found. Add your services!</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>