<%- include('header.ejs'); %>

<!-- ===== DASHBOARD CONTENT ===== -->
<div class="page-content">
  <div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
      <div>
        <h1 class="h3 mb-1">Add Post</h1>
        <p class="text-muted small mb-0">Welcome back, Here's your overview</p>
      </div>
      <div></div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4 pe-3">
      <div class="col-12 mb-1">
        <form
          action="/admin/blog_add_save"
          method="post"
          enctype="multipart/form-data"
        >
          <label for="">Post Title</label>
          <input type="text" class="form-control" name="post_name" /> <br />

          <label for="">Post Description</label>
          <input type="text" class="form-control" name="post_des" id="" /> <br />

          <label for="">Post Image</label>
          <input type="file" class="form-control" name="post_photo" id="" />
          <br />

          <button class="btn btn-primary">Save</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('footer.ejs'); %>
