<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Manage Education</h1>
        <p class="text-muted small mb-0">Overview of your academic background</p>
      </div>
      <a href="/admin/education_add" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Add Education
      </a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Duration</th>
                <th>Degree / Certification</th>
                <th>Institution</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (education && education.length > 0) { %>
                <% for (let i = 0; i < education.length; i++) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td><span class="badge bg-secondary-subtle text-dark"><%= education[i].edu_dur %></span></td>
                    <td class="fw-semibold"><%= education[i].edu_deg %></td>
                    <td><%= education[i].edu_coll %></td>
                    <td class="text-end">
                      <a href="/admin/edit_education/<%= education[i].edu_id %>" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                      </a>
                      <a href="/admin/delete_education/<%= education[i].edu_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this education record?')" title="Delete">
                        <i class="fas fa-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% } %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">No education records found. Add your education!</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>