<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Manage Blog Posts</h1>
        <p class="text-muted small mb-0">Overview of all published articles</p>
      </div>
      <a href="/admin/blog_add" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Add Post
      </a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Cover</th>
                <th>Title</th>
                <th>Description</th>
                <th>Date</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (blog && blog.length > 0) { %>
                <% for (let i = 0; i < blog.length; i++) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td>
                      <% if (blog[i].post_photo) { %>
                        <img src="/<%= blog[i].post_photo %>" alt="" class="rounded shadow-sm" style="width: 60px; height: 40px; object-fit: cover;" />
                      <% } else { %>
                        <span class="badge bg-secondary">No Image</span>
                      <% } %>
                    </td>
                    <td class="fw-semibold" style="max-width: 200px;"><%= blog[i].post_name %></td>
                    <td class="text-truncate" style="max-width: 250px;"><%= blog[i].post_des %></td>
                    <td><small class="text-muted"><%= blog[i].date %></small></td>
                    <td class="text-end">
                      <a href="/admin/edit_blog/<%= blog[i].b_id %>" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                      </a>
                      <a href="/admin/delete_blog/<%= blog[i].b_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this blog post?')" title="Delete">
                        <i class="fas fa-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% } %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">No blog posts found. Create your first post!</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>