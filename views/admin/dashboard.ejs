<%- include('header.ejs'); %>

<!-- ===== DASHBOARD CONTENT ===== -->
<div class="page-content">
  <div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1 font-weight-bold">Dashboard</h1>
        <p class="text-muted small mb-0">Welcome back, <%= username %>! Here is your live portfolio control overview.</p>
      </div>
      <div>
        <a href="/admin/project_add" class="btn btn-primary shadow-sm">
          <i class="fas fa-plus me-2"></i>New Project
        </a>
      </div>
    </div>

    <!-- Live Stat Cards -->
    <div class="row g-4 mb-4">
      <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="stat-card card-glass shadow-sm">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="stat-label text-muted d-block mb-1">Total Projects</span>
              <h2 class="stat-number mb-0 font-weight-bold"><%= projectCount %></h2>
            </div>
            <div class="stat-icon bg-primary text-white rounded-circle">
              <i class="fas fa-folder-open"></i>
            </div>
          </div>
          <div class="mt-3 pt-2 border-top">
            <a href="/admin/project_manage" class="small text-primary text-decoration-none fw-semibold">
              Manage Projects <i class="fas fa-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="stat-card card-glass shadow-sm">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="stat-label text-muted d-block mb-1">Blog Articles</span>
              <h2 class="stat-number mb-0 font-weight-bold"><%= blogCount %></h2>
            </div>
            <div class="stat-icon bg-success text-white rounded-circle">
              <i class="fas fa-newspaper"></i>
            </div>
          </div>
          <div class="mt-3 pt-2 border-top">
            <a href="/admin/blog_manage" class="small text-success text-decoration-none fw-semibold">
              Manage Articles <i class="fas fa-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="stat-card card-glass shadow-sm">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="stat-label text-muted d-block mb-1">Pending Enquiries</span>
              <h2 class="stat-number mb-0 font-weight-bold"><%= pendingEnquiries %></h2>
            </div>
            <div class="stat-icon bg-warning text-white rounded-circle">
              <i class="fas fa-envelope"></i>
            </div>
          </div>
          <div class="mt-3 pt-2 border-top">
            <a href="/admin/enquiries" class="small text-warning text-decoration-none fw-semibold">
              View Messages <i class="fas fa-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="stat-card card-glass shadow-sm">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="stat-label text-muted d-block mb-1">Technical Skills</span>
              <h2 class="stat-number mb-0 font-weight-bold"><%= skillCount %></h2>
            </div>
            <div class="stat-icon bg-info text-white rounded-circle">
              <i class="fas fa-code"></i>
            </div>
          </div>
          <div class="mt-3 pt-2 border-top">
            <a href="/admin/skill_list" class="small text-info text-decoration-none fw-semibold">
              Manage Skills <i class="fas fa-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
      <div class="col-xl-8 col-lg-12">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <h5 class="card-title mb-0 font-weight-bold">
              <i class="fas fa-chart-line text-primary me-2"></i>Portfolio Visitor Activity & Traffic
            </h5>
            <span class="badge bg-primary-subtle text-primary">Live Overview</span>
          </div>
          <div class="card-body">
            <canvas id="visitorsChart" height="230"></canvas>
          </div>
        </div>
      </div>

      <div class="col-xl-4 col-lg-12">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-transparent border-0 py-3">
            <h5 class="card-title mb-0 font-weight-bold">
              <i class="fas fa-pie-chart text-success me-2"></i>Content Overview
            </h5>
          </div>
          <div class="card-body">
            <canvas id="categoriesChart" height="230"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Enquiries & Projects Table -->
    <div class="row g-4">
      <div class="col-xl-7 col-lg-12">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <h5 class="card-title mb-0 font-weight-bold">
              <i class="fas fa-paper-plane text-primary me-2"></i>Recent Contact Enquiries
            </h5>
            <a href="/admin/enquiries" class="btn btn-sm btn-light">View All</a>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Sender</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentEnquiries && recentEnquiries.length > 0) { %>
                    <% recentEnquiries.forEach(item => { %>
                      <tr>
                        <td>
                          <div class="fw-bold"><%= item.name %></div>
                          <div class="small text-muted"><%= item.email %></div>
                        </td>
                        <td><%= item.subject %></td>
                        <td>
                          <% if (item.status === 'pending') { %>
                            <span class="badge bg-warning-subtle text-warning">Pending</span>
                          <% } else { %>
                            <span class="badge bg-success-subtle text-success">Accepted</span>
                          <% } %>
                        </td>
                        <td><small class="text-muted"><%= new Date(item.created_at).toLocaleDateString() %></small></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" class="text-center py-4 text-muted">No recent contact messages</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-xl-5 col-lg-12">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <h5 class="card-title mb-0 font-weight-bold">
              <i class="fas fa-layer-group text-info me-2"></i>Latest Projects
            </h5>
            <a href="/admin/project_manage" class="btn btn-sm btn-light">View All</a>
          </div>
          <div class="card-body p-0">
            <div class="list-group list-group-flush">
              <% if (recentProjects && recentProjects.length > 0) { %>
                <% recentProjects.forEach(item => { %>
                  <div class="list-group-item d-flex align-items-center justify-content-between py-3">
                    <div class="d-flex align-items-center gap-3">
                      <% if (item.pr_photo) { %>
                        <img src="/<%= item.pr_photo %>" alt="" class="rounded" style="width: 45px; height: 35px; object-fit: cover;" />
                      <% } else { %>
                        <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center" style="width: 45px; height: 35px;">
                          <i class="fas fa-image"></i>
                        </div>
                      <% } %>
                      <div>
                        <div class="fw-bold"><%= item.pr_name %></div>
                        <small class="text-muted"><%= item.pr_cate %></small>
                      </div>
                    </div>
                    <a href="/admin/edit_project/<%= item.pr_id %>" class="btn btn-sm btn-light">
                      <i class="fas fa-edit"></i>
                    </a>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="p-4 text-center text-muted">No projects added yet</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('footer.ejs'); %>