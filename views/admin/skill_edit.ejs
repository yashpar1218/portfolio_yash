<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Edit Technical Skill</h1>
        <p class="text-muted small mb-0">Update skill name and proficiency level</p>
      </div>
      <a href="/admin/skill_list" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i> Back to Skills
      </a>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <form action="/admin/update_skill/<%= skill.ts_id %>" method="post">
              <div class="mb-3">
                <label class="form-label fw-semibold">Technology Name</label>
                <input type="text" name="tech_name" class="form-control" value="<%= skill.tech_name %>" required />
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Proficiency Percentage (%)</label>
                <input type="number" name="tech_per" class="form-control" min="1" max="100" value="<%= skill.tech_per %>" required />
              </div>

              <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/admin/skill_list" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save me-1"></i> Update Skill
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>
