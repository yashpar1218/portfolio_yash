<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Manage Work Experience</h1>
        <p class="text-muted small mb-0">Overview of your career journey</p>
      </div>
      <a href="/admin/experience_add" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Add Experience
      </a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Duration</th>
                <th>Position</th>
                <th>Company</th>
                <th>Description</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (experience && experience.length > 0) { %>
                <% for (let i = 0; i < experience.length; i++) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td><span class="badge bg-secondary-subtle text-dark"><%= experience[i].exp_dur %></span></td>
                    <td class="fw-semibold"><%= experience[i].exp_pos %></td>
                    <td><%= experience[i].exp_com %></td>
                    <td class="text-truncate" style="max-width: 250px;"><%= experience[i].exp_des %></td>
                    <td class="text-end">
                      <a href="/admin/edit_experience/<%= experience[i].eid %>" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                      </a>
                      <a href="/admin/delete_experience/<%= experience[i].eid %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this experience entry?')" title="Delete">
                        <i class="fas fa-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% } %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">No experience entries found. Add your work experience!</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>