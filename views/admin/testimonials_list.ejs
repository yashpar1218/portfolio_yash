<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Manage Testimonials</h1>
        <p class="text-muted small mb-0">Overview of client reviews and ratings</p>
      </div>
      <a href="/admin/testimonials_add" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Add Testimonial
      </a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Client Name</th>
                <th>Role / Company</th>
                <th>Testimonial Text</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (testimonial && testimonial.length > 0) { %>
                <% for (let i = 0; i < testimonial.length; i++) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td class="fw-semibold"><%= testimonial[i].ser_ico %></td>
                    <td><span class="badge bg-secondary-subtle text-dark"><%= testimonial[i].ser_nam %></span></td>
                    <td class="text-truncate" style="max-width: 300px;"><%= testimonial[i].ser_des %></td>
                    <td class="text-end">
                      <a href="/admin/edit_testimonial/<%= testimonial[i].t_id %>" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                      </a>
                      <a href="/admin/delete_testimonial/<%= testimonial[i].t_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this testimonial?')" title="Delete">
                        <i class="fas fa-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% } %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">No testimonials found. Add your first testimonial!</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>