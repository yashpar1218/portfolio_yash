<%- include('header.ejs'); %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Edit About Section</h1>
        <p class="text-muted small mb-0">Manage biography, primary role, contact email, location, and photo</p>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <form action="/admin/update_about" method="post" enctype="multipart/form-data">
              <input type="hidden" name="old_pfp" value="<%= about ? about.image : '' %>" />

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-semibold">Name</label>
                  <input type="text" class="form-control" name="about_name" value="<%= about ? about.name : '' %>" required />
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-semibold">Role / Title</label>
                  <input type="text" class="form-control" name="about_role" value="<%= about ? about.role : '' %>" required />
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-semibold">Email</label>
                  <input type="email" class="form-control" name="about_email" value="<%= about ? about.email : '' %>" required />
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-semibold">Location</label>
                  <input type="text" class="form-control" name="about_loc" value="<%= about ? about.loc : '' %>" required />
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Full Bio / Description</label>
                <textarea class="form-control" name="about_des" rows="5" required><%= about ? about.des : '' %></textarea>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">About Photo</label>
                <% if (about && about.image) { %>
                  <div class="mb-2">
                    <img src="/<%= about.image %>" height="120" class="rounded shadow-sm" alt="About Photo" />
                  </div>
                <% } %>
                <input type="file" class="form-control" name="about_pfp" accept="image/*" />
                <small class="text-muted">Leave blank to keep existing photo</small>
              </div>

              <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary px-4">
                  <i class="fas fa-save me-1"></i> Save Changes
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs'); %>
