<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Edit Experience</h1>
        <p class="text-muted small mb-0">Update work experience entry</p>
      </div>
      <a href="/admin/experience_list" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i> Back to Experience
      </a>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <form action="/admin/update_experience/<%= experience.eid %>" method="post">
              <div class="mb-3">
                <label class="form-label fw-semibold">Duration</label>
                <input type="text" name="exp_dur" class="form-control" value="<%= experience.exp_dur %>" placeholder="e.g. Mar '26 - Jul '26" required />
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Job Position / Title</label>
                <input type="text" name="exp_pos" class="form-control" value="<%= experience.exp_pos %>" required />
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Company / Organization</label>
                <input type="text" name="exp_com" class="form-control" value="<%= experience.exp_com %>" required />
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Description</label>
                <textarea name="exp_des" class="form-control" rows="3" required><%= experience.exp_des %></textarea>
              </div>

              <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/admin/experience_list" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save me-1"></i> Update Experience
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>
