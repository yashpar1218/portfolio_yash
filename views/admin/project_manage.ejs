<%- include('header.ejs') %>
<div class="page-content">
  <div class="container-fluid">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Manage Projects</h1>
        <p class="text-muted small mb-0">Overview of all portfolio items</p>
      </div>
      <a href="/admin/project_add" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Add Project
      </a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Thumbnail</th>
                <th>Project Name</th>
                <th>Category</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (project && project.length > 0) { %>
                <% for (let i = 0; i < project.length; i++) { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td>
                      <% if (project[i].pr_photo) { %>
                        <img src="/<%= project[i].pr_photo %>" alt="" class="rounded shadow-sm" style="width: 60px; height: 40px; object-fit: cover;" />
                      <% } else { %>
                        <span class="badge bg-secondary">No Image</span>
                      <% } %>
                    </td>
                    <td class="fw-semibold"><%= project[i].pr_name %></td>
                    <td><span class="badge bg-primary-subtle text-primary rounded-pill px-3"><%= project[i].pr_cate %></span></td>
                    <td class="text-end">
                      <a href="/admin/edit_project/<%= project[i].pr_id %>" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                      </a>
                      <a href="/admin/delete_project/<%= project[i].pr_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this project?')" title="Delete">
                        <i class="fas fa-trash"></i>
                      </a>
                    </td>
                  </tr>
                <% } %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">No projects found. Add your first project!</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer.ejs') %>